# Copy to .env and fill in your key. .env is gitignored.

# WeRead Agent API key. Generate at https://weread.qq.com/r/weread-skills
# (log in, then copy the wrk-xxxx key). Required.
WEREAD_API_KEY=wrk-xxxxxxxx

# Timezone for day boundaries and the schedule (IANA name).
TZ=Asia/Shanghai

# Daily pull schedule, cron syntax: minute hour day month weekday.
PULL_CRON=0 3 * * *

# Host port to expose the dashboard on.
PORT=8765

# Skill version sent to the gateway (bump if it asks you to upgrade).
SKILL_VERSION=1.0.3
